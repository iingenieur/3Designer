    "footR": 7.5, "footH": 5.5, "bodyR": 10, "bodyZ": 12, "wall": 1.2,
    "neckR": 5, "neckZ": 18, "rimR": 6, "rimH": 1.5, "topZ": 29,
    "handleX": 8.3, "handleZ": 20, "handleR": 3.4, "handleHole": 2, "handleT": 1.6
  },
  "features": [

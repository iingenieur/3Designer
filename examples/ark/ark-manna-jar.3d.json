    { "id": "neck", "type": "cylinder", "name": "목", "radius": "neckR", "height": "topZ - neckZ", "transform": { "position": [0, 0, "neckZ"] } },
    { "id": "rim", "type": "cylinder", "name": "입술", "radius": "rimR", "height": "rimH", "transform": { "position": [0, 0, "topZ - rimH"] } },

      "pattern": { "pattern": "linear", "count": 2, "spacing": "2*handleX", "direction": "X" },
      "transform": { "rotation": [90, 0, 0], "position": ["-handleX", "handleT/2 + 1", "handleZ"] } },
    { "id": "cavity", "type": "sphere", "name": "내부 (cut)", "op": "cut", "radius": "bodyR - wall", "transform": { "position": [0, 0, "bodyZ"] } },
    { "id": "bore", "type": "cylinder", "name": "목 구멍 (cut)", "op": "cut", "radius": "neckR - wall", "height": "topZ", "transform": { "position": [0, 0, "bodyZ + 4"] } }
  ]

{
  "version": 1,
  "units": "mm",
  "parameters": {
    "boardW": 85, "boardD": 56, "gap": 1.5, "wall": 2, "floorT": 2, "H": 27, "cornerR": 4,
    "soD": 6, "soH": 5, "screwD": 2.2, "holeOffX": 3.5, "holeSpX": 58, "holeSpY": 49,
    "windowZ": 8, "sideWinH": 8, "sdW": 14, "sdH": 5, "ventN": 6, "footChamfer": 0.5
  },
  "features": [
    { "id": "shell", "type": "extrude", "name": "케이스 외형", "plane": "XY", "height": "H",

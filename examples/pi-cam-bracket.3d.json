{
  "version": 1,
  "units": "mm",
  "parameters": {
    "boardW": 85, "boardD": 56, "margin": 3.5, "ext": 10, "plateT": 3, "cornerR": 4,
    "soD": 6, "soH": 6, "screwD": 2.2, "holeOffX": 3.5, "holeSpX": 58, "holeSpY": 49, "mountD": 4.4,
    "holeX": 21, "holeZ": 12.5, "camScrewD": 1.8, "camSoD": 4.5, "camSoH": 4,
    "camPlateW": 29, "camPlateT": 3, "camPlateH": 30.5, "camLoZ": 13.5, "footChamfer": 0.5
  },
  "features": [
    { "id": "plate", "type": "extrude", "name": "플레이트 (뒤쪽 연장)", "plane": "XY", "height": "plateT",
      "profile": { "kind": "rect", "width": "boardW + 2*margin", "height": "boardD + 2*margin + ext", "cornerRadius": "cornerR" },
      "transform": { "position": [0, "ext/2", 0] } },
    { "id": "mount", "type": "hole", "name": "고정 구멍 (M4)", "diameter": "mountD",
      "positions": [["-(boardW/2 + margin - 6)", 0], ["boardW/2 + margin - 6", 0], [0, "-(boardD/2 + margin - 4.5)"]] },
    { "id": "foot", "type": "chamfer", "name": "바닥 모따기", "distance": "footChamfer", "edges": "bottom" },
    { "id": "soA", "type": "cylinder", "name": "Pi 스탠드오프 앞줄 (M2.5)", "radius": "soD/2", "height": "plateT + soH",
      "pattern": { "pattern": "linear", "count": 2, "spacing": "holeSpX", "direction": "X" },
      "transform": { "position": ["-boardW/2 + holeOffX", "-holeSpY/2", 0] } },
    { "id": "soB", "type": "cylinder", "name": "Pi 스탠드오프 뒷줄 (M2.5)", "radius": "soD/2", "height": "plateT + soH",
      "pattern": { "pattern": "linear", "count": 2, "spacing": "holeSpX", "direction": "X" },
      "transform": { "position": ["-boardW/2 + holeOffX", "holeSpY/2", 0] } },
    { "id": "screws", "type": "hole", "name": "Pi 나사 구멍 (M2.5 셀프탭)", "diameter": "screwD",
      "positions": [["-boardW/2 + holeOffX", "-holeSpY/2"], ["-boardW/2 + holeOffX + holeSpX", "-holeSpY/2"],
                    ["-boardW/2 + holeOffX", "holeSpY/2"], ["-boardW/2 + holeOffX + holeSpX", "holeSpY/2"]] },
    { "id": "camPlate", "type": "box", "name": "카메라 타워 (뒤쪽 가장자리)",
      "size": ["camPlateW", "camPlateT", "camPlateH"],
      "transform": { "position": [0, "boardD/2 + margin + ext - camPlateT/2", 0] } },
    { "id": "camSoLo", "type": "cylinder", "name": "카메라 스탠드오프 아랫줄 (M2)", "radius": "camSoD/2", "height": "camSoH",
      "transform": { "rotation": [-90, 0, 0], "position": ["-holeX/2", "boardD/2 + margin + ext", "camLoZ"] },
      "pattern": { "pattern": "linear", "count": 2, "spacing": "holeX", "direction": "X" } },
    { "id": "camSoHi", "type": "cylinder", "name": "카메라 스탠드오프 윗줄 (M2)", "radius": "camSoD/2", "height": "camSoH",
      "transform": { "rotation": [-90, 0, 0], "position": ["-holeX/2", "boardD/2 + margin + ext", "camLoZ + holeZ"] },
      "pattern": { "pattern": "linear", "count": 2, "spacing": "holeX", "direction": "X" } },
    { "id": "camScLo", "type": "cylinder", "name": "카메라 나사 구멍 아랫줄 (cut)", "op": "cut", "radius": "camScrewD/2", "height": "camSoH + 2",
      "transform": { "rotation": [-90, 0, 0], "position": ["-holeX/2", "boardD/2 + margin + ext - 2", "camLoZ"] },
      "pattern": { "pattern": "linear", "count": 2, "spacing": "holeX", "direction": "X" } },
    { "id": "camScHi", "type": "cylinder", "name": "카메라 나사 구멍 윗줄 (cut)", "op": "cut", "radius": "camScrewD/2", "height": "camSoH + 2",
      "transform": { "rotation": [-90, 0, 0], "position": ["-holeX/2", "boardD/2 + margin + ext - 2", "camLoZ + holeZ"] },
      "pattern": { "pattern": "linear", "count": 2, "spacing": "holeX", "direction": "X" } }
  ]
}
